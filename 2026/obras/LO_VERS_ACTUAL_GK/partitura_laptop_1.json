  "instrucciones": [
    {
      "en": "00:00",
      "titulo": "Negar con la cabeza",
      "texto": "Gira la cabeza de un lado a otro, como al decir «no». Mantén el torso quieto.",
      "imagen": "gestos/01_cabeza_negacion.png"
    },
    {
      "en": "00:28",
      "titulo": "Balancear el torso",
      "texto": "Inclina el torso hacia un lado y luego hacia el otro, como un péndulo invertido. Mantén la pelvis en su sitio.",
      "imagen": "gestos/03_torso_pendulo.png"
    },
    {
      "en": "00:52",
      "titulo": "Arco con el brazo derecho",
      "texto": "Traza con el brazo derecho un arco de izquierda a derecha en el encuadre.",
      "imagen": "gestos/07_arco_brazo_derecho.png"
    },
    {
      "en": "01:08",
      "titulo": "Brazo derecho libre",
      "texto": "Mueve libremente el brazo derecho dentro del encuadre. Deja el izquierdo en reposo.",
      "imagen": "gestos/04_brazo_derecho_libre.png"
    },
    {
      "en": "01:52",
      "titulo": "Acercar y alejar el rostro",
      "texto": "Acerca y aleja el rostro de la webcam. Mantenlo en el centro del encuadre.",
      "imagen": "gestos/02_rostro_distancia.png"
    },
    {
      "en": "02:12",
      "titulo": "Negar con la cabeza",
      "texto": "Gira la cabeza de un lado a otro, como al decir «no». Mantén el torso quieto.",
      "imagen": "gestos/01_cabeza_negacion.png"
    },
    {
      "en": "02:36",
      "titulo": "Dedos de la mano derecha",
      "texto": "Acerca la mano derecha a la webcam y mueve los dedos. Mantén la palma en su sitio.",
      "imagen": "gestos/10_dedos_mano_derecha.png"
    },
    {
      "en": "03:12",
      "titulo": "Acercar el computador",
      "texto": "Levanta el computador con ambas manos y acércalo a tu rostro. Mantén la webcam orientada hacia ti.",
      "imagen": "gestos/13_acercar_computador.png"
    },
    {
      "en": "04:16",
      "titulo": "Quietud",
      "texto": "Deja el computador sobre la mesa y quédate quieto. En cada «Muévete», haz un gesto breve."
    },
    {
      "en": "04:48",
      "titulo": "Negar con la cabeza",
      "texto": "Gira la cabeza de un lado a otro, como al decir «no». Mantén el torso quieto.",
      "imagen": "gestos/01_cabeza_negacion.png"
    },
    {
      "en": "05:08",
      "titulo": "Dedos de ambas manos",
      "texto": "Acerca ambas manos a la webcam y mueve los dedos. Mantén las palmas en su sitio.",
      "imagen": "gestos/12_dedos_ambas_manos.png"
    },
    {
      "en": "05:36",
      "titulo": "Arco con ambos brazos",
      "texto": "Mueve ambos brazos juntos, trazando un arco de izquierda a derecha en el encuadre.",
      "imagen": "gestos/09_arco_ambos_brazos.png"
    },
    {
      "en": "05:48",
      "titulo": "Ambos brazos libres",
      "texto": "Mueve libremente ambos brazos dentro del encuadre. Puedes moverlos juntos o por separado.",
      "imagen": "gestos/06_ambos_brazos_libres.png"
    }
  ],
