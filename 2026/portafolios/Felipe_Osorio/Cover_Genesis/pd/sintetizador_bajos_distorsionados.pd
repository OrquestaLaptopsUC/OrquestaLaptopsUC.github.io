#N canvas 60 40 960 660 12;
#X text 20 10 SINTETIZADOR DE BAJOS DISTORSIONADOS · Cover de Genesis · Orquesta de Laptops UC;
#X text 20 32 Diseña el sonido con los sliders y genera archivos .wav para la página (sonidos/sintetizados/). Pd vanilla 0.51 o más nuevo.;
#X obj 30 90 hsl 160 18 0 1 0 1 drive drive-in Distorsión 0 -10 0 12 #fcfcfc #000000 #000000 9540 1;
#X obj 30 135 hsl 160 18 0 1 0 1 fuzz fuzz-in Fuzz 0 -10 0 12 #fcfcfc #000000 #000000 4770 1;
#X obj 30 180 hsl 160 18 0 1 0 1 crush crush-in Bitcrush 0 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 30 225 hsl 160 18 0 1 0 1 tono tono-in Tono 0 -10 0 12 #fcfcfc #000000 #000000 7155 1;
#X obj 30 270 hsl 160 18 0.5 8 0 1 reso reso-in Resonancia 0 -10 0 12 #fcfcfc #000000 #000000 2120 1;
#X obj 240 90 hsl 160 18 0 1 0 1 sub sub-in Sub-octava 0 -10 0 12 #fcfcfc #000000 #000000 9540 1;
#X obj 240 135 hsl 160 18 0 1 0 1 detune detune-in Desafinación 0 -10 0 12 #fcfcfc #000000 #000000 3975 1;
#X obj 240 180 hsl 160 18 0 300 0 1 glide glide-in Glide 0 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 240 225 hsl 160 18 0 1 0 1 vol vol-in Volumen 0 -10 0 12 #fcfcfc #000000 #000000 11130 1;
#X text 470 78 1) Probar el sonido actual:;
#X msg 470 100  \; nota-bajo 34 100;
#X msg 620 100  \; nota-bajo 34 0;
#X text 740 102 Si♭1 on / off;
#X msg 470 128  \; nota-bajo 30 100;
#X msg 620 128  \; nota-bajo 30 0;
#X text 740 130 Sol♭1 on / off;
#X text 470 170 2) Generar un lote (Si♭1 + Sol♭1 + Re♭2 · ~11 s):;
#X msg 470 195  \; lote symbol actual;
#X text 650 197 con los sliders tal como están;
#X text 470 230 3) Presets de la obra (ajustan y graban):;
#X msg 470 255  \; drive-in 0.6 \; fuzz-in 0.3 \; crush-in 0 \; tono-in 0.45 \; reso-in 1.5 \; lote symbol dist60;
#X text 840 257 0:32 · 60%;
#X msg 470 287  \; drive-in 0 \; fuzz-in 0 \; crush-in 0 \; tono-in 0.35 \; reso-in 1.2 \; lote symbol limpio;
#X text 840 289 1:17 · limpio;
#X msg 470 319  \; drive-in 0.9 \; fuzz-in 0.8 \; crush-in 0.25 \; tono-in 0.6 \; reso-in 3 \; lote symbol muro;
#X text 840 321 1:32 · muro;
#X msg 470 351  \; drive-in 0.2 \; fuzz-in 0 \; crush-in 0 \; tono-in 0.3 \; reso-in 1.5 \; lote symbol final;
#X text 840 353 2:30 · 20%;
#X msg 470 390  \; todo bang;
#X text 560 392 4) generar los 4 presets seguidos (~45 s · 12 archivos);
#X obj 30 390 r todo;
#X obj 30 420 t b b b b;
#X obj 30 450 delay 0;
#X obj 120 450 delay 11000;
#X obj 210 450 delay 22000;
#X obj 300 450 delay 33000;
#X text 30 500 Los archivos quedan en ../sonidos/sintetizados/ como bajo_<preset>_<nota>.wav (la carpeta debe existir). Mira la consola de Pd: dice 'generando' en cada archivo.;
#X obj 30 540 loadbang;
#X msg 30 565  \; pd dsp 1;
#X msg 150 565  \; pd dsp 0;
#X text 240 567 apagar audio;
#N canvas 120 80 920 800 sintesis 0;
#X text 10 10 Síntesis: 2 sierras desafinadas + sub-octava cuadrada -> envolvente -> ganancia -> tanh -> fuzz (clip) -> bitcrush -> filtro resonante vcf~ -> volumen -> s~ bajo-out;
#X obj 20 50 r nota-bajo;
#X obj 20 80 unpack f f;
#X obj 120 110 > 0;
#X obj 120 140 t f f;
#X obj 170 170 == 0;
#X obj 20 140 t f f;
#X obj 20 210 spigot;
#X obj 160 210 spigot;
#X obj 20 250 t b f f;
#X obj 160 250 ==;
#X obj 160 280 sel 1;
#X msg 20 370 1 6 \, 0.85 250 6;
#X msg 160 370 0 450;
#X obj 20 410 vline~;
#X obj 60 280 mtof;
#X obj 60 310 pack f 40;
#X obj 110 280 r glide;
#X obj 60 340 line~;
#X obj 420 60 phasor~;
#X obj 500 60 *~ 1.007;
#X obj 500 90 phasor~;
#X obj 620 60 *~ 0.5;
#X obj 620 90 phasor~;
#X obj 760 30 r detune;
#X obj 760 60 expr 1 + $f1*0.03;
#X obj 420 130 expr~ $v1 + $v2 - 1;
#X obj 620 130 expr~ ($v1 < 0.5)*2 - 1;
#X obj 620 160 *~ 0.6;
#X obj 760 130 r sub;
#X obj 420 200 *~;
#X obj 560 200 r drive;
#X obj 560 230 expr 0.4*pow(100\, $f1);
#X obj 560 260 pack f 30;
#X obj 560 290 line~;
#X obj 420 320 *~;
#X obj 420 350 expr~ tanh($v1);
#X obj 560 340 r fuzz;
#X obj 560 370 expr 1 + $f1*9;
#X obj 560 400 pack f 30;
#X obj 560 430 line~;
#X obj 420 460 *~;
#X obj 420 490 clip~ -0.7 0.7;
#X obj 760 490 r crush;
#X obj 760 520 expr pow(2\, 15 - 13*$f1);
#X obj 420 520 expr~ floor($v1*$f2 + 0.5)/$f2;
#X obj 620 560 r tono;
#X obj 620 590 expr 60*pow(100\, $f1);
#X obj 620 620 pack f 40;
#X obj 620 650 line~;
#X obj 760 620 r reso;
#X obj 420 680 vcf~ 1.5;
#X obj 420 710 hip~ 30;
#X obj 560 710 r vol;
#X obj 560 740 pack f 50;
#X obj 560 770 line~;
#X obj 420 740 *~;
#X obj 420 770 clip~ -0.99 0.99;
#X obj 300 800 s~ bajo-out;
#X obj 420 800 dac~;
